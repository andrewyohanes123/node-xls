{
  "name": "node-xls",
  "version": "0.1.0",
  "description": "XLSX reader/writer with a SheetJS-compatible API plus the features SheetJS reserves for Pro: cell styling, rich text, conditional formatting, data validation, tables, images, charts and pivot tables.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=Asia/Jakarta vitest run && TZ=America/New_York vitest run && TZ=Pacific/Kiritimati vitest run",
    "test:lo": "npm run showcase && scripts/render.sh",
    "schemas": "scripts/fetch-schemas.sh",
    "showcase": "npm run build && node scripts/showcase.mjs",
    "inspect": "node scripts/inspect.mjs",
    "render": "scripts/render.sh",
    "excel-check": "npm run showcase && node scripts/excel-check.mjs"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "pivot",
    "pivot-table",
    "styling",
    "sheetjs",
    "styles",
    "openxml",
    "charts",
    "images",
    "conditional-formatting",
    "data-validation"
  ],
  "author": "andrew.yohanes123@gmail.com",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ssf": "^0.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
