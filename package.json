{
  "name": "node-xls",
  "version": "0.0.1",
  "description": "Full-featured XLSX library compatible with SheetJS xlsx, with first-class cell styling and pivot tables.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=Asia/Jakarta vitest run && TZ=America/New_York vitest run && TZ=Pacific/Kiritimati vitest run",
    "test:lo": "npm run showcase && scripts/render.sh",
    "schemas": "scripts/fetch-schemas.sh",
    "showcase": "npm run build && node scripts/showcase.mjs",
    "inspect": "node scripts/inspect.mjs",
    "render": "scripts/render.sh",
    "excel-check": "npm run showcase && node scripts/excel-check.mjs"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "pivot",
    "pivot-table",
    "styling",
    "sheetjs",
    "styles",
    "openxml"
  ],
  "author": "andrew.yohanes123@gmail.com",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ssf": "^0.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
